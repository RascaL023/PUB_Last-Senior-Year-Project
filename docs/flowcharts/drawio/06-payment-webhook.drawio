  <diagram id="06-payment-webhook" name="06-payment-webhook">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1336" pageHeight="1248" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Diagram 6 — Webhook Xendit: verifikasi, idempotensi, dan update payment" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#4527A0;" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="1296" height="26" as="geometry" />
        </mxCell>
        <mxCell id="WH" value="POST /api/v1/payments/webhooks/xendit&lt;br/&gt;endpoint publik, header X-Callback-Token" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="748" y="68" width="302" height="55" as="geometry" />
        </mxCell>
        <mxCell id="TK" value="Callback token cocok?" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#311B92;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rhombus;" vertex="1" parent="1">
          <mxGeometry x="814" y="178" width="170" height="44" as="geometry" />
        </mxCell>
        <mxCell id="E401" value="401 Unauthorized" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="1045" y="283" width="135" height="44" as="geometry" />
        </mxCell>
        <mxCell id="PARSE" value="Payload JSON dapat diparse?" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#311B92;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rhombus;" vertex="1" parent="1">
          <mxGeometry x="793" y="283" width="212" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ACK1" value="200 OK — di-ack tanpa efek&lt;br/&gt;retry Xendit berhenti" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="947" y="405" width="205" height="55" as="geometry" />
        </mxCell>
        <mxCell id="MAP" value="Petakan status payload ke PaymentStatus:&lt;br/&gt;PAID atau SUCCESS menjadi PAID, EXPIRED menjadi EXPIRED,&lt;br/&gt;PENDING menjadi PENDING, lainnya menjadi FAILED&lt;br/&gt;settledAmount = paidAmount, fallback ke amount" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry x="547" y="387" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="D_APPLY" value="Webhook ini berlaku?&lt;br/&gt;externalId dikenal dan status payload&lt;br/&gt;berbeda dengan status di database" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#311B92;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rhombus;" vertex="1" parent="1">
          <mxGeometry x="586" y="532" width="282" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ACK2" value="200 OK — di-ack tanpa efek:&lt;br/&gt;externalId tidak dikenal atau redelivery status sama" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="211" y="659" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="LATE" value="Late settlement:&lt;br/&gt;EXPIRED atau FAILED menjadi PAID?" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#311B92;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rhombus;" vertex="1" parent="1">
          <mxGeometry x="611" y="659" width="254" height="55" as="geometry" />
        </mxCell>
        <mxCell id="FLOW" value="PaymentStatusFlowPolicy.validateFlow&lt;br/&gt;transisi diizinkan?" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#311B92;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rhombus;" vertex="1" parent="1">
          <mxGeometry x="600" y="769" width="275" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ACK3" value="200 OK — webhook basi di-ack dan dicatat di log" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="587" y="893" width="351" height="44" as="geometry" />
        </mxCell>
        <mxCell id="SET" value="Update payment: status, amount bila paid_amount ada,&lt;br/&gt;paidAt lewat PaymentEffect.applyEffectIfPaid,&lt;br/&gt;rawWebhook, method, channel, updatedAt" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry x="187" y="879" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="W_BAD" value="200 OK — BadRequestException di-ack agar Xendit berhenti retry" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="905" y="665" width="360" height="44" as="geometry" />
        </mxCell>
        <mxCell id="W_500" value="500 Internal Server Error — Xendit akan retry" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="20" y="1012" width="337" height="44" as="geometry" />
        </mxCell>
        <mxCell id="EVT" value="PaymentSettledEvent&lt;br/&gt;dipublikasikan bila status menjadi PAID" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry x="397" y="1006" width="295" height="55" as="geometry" />
        </mxCell>
        <mxCell id="LISTEN" value="InvoicePaymentEventListener menerima event&lt;br/&gt;@TransactionalEventListener AFTER_COMMIT&lt;br/&gt;— lanjut ke diagram 07-payment-settlement" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#212121;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=1;shape=rectangle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="387" y="1116" width="316" height="72" as="geometry" />
        </mxCell>
        <mxCell id="N_TOKEN" value="Token tidak cocok dibalas 401 pada tingkat controller;&lt;br/&gt;hanya webhook Xendit dan ImageKit yang dibuka tanpa JWT" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#5D4037;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;shape=rectangle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="393" y="277" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="N_LATE" value="Alasan late settlement ditangani terpisah: pembeli bisa membayar&lt;br/&gt;setelah payment ditandai EXPIRED atau FAILED, dan uangnya tetap masuk" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#5D4037;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;shape=rectangle;dashed=1;" vertex="1" parent="1">
