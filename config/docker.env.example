# ============================================================
# Docker Environment — Template
# ============================================================
# Copy file ini ke docker.env lalu isi sesuai kebutuhan:
#   cp config/docker.env.example config/docker.env
#
# File ini adalah SSOT untuk SEMUA config Docker.
# Tidak ada .env lain yang dibaca.
#
# Usage:
#   docker compose --env-file config/docker.env up -d
#
# Flow:
#   config/docker.env
#     ├──→ docker-compose.yml (substitute ${VAR} via --env-file)
#     └──→ Spring Boot (via spring.config.import + APP_ENV=docker)
#
# Format: UPPER_SNAKE_CASE
#
# ⚠️ JANGAN commit docker.env ke version control!
# ============================================================


# ── Build (GitHub Packages) ──────────────────────────────
# Dibutuhkan untuk download custom library (id.rascal:filter)
# Perlu PAT
GITHUB_USER=your_github_username
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx


# ── PostgreSQL ───────────────────────────────────────────
# Port external (host) — ubah kalau ada conflict
DB_EXTERNAL_PORT=5432

# ── Backend ──────────────────────────────────────────────
BACKEND_PORT=8081

# ── Nginx ────────────────────────────────────────────────
NGINX_PORT=9000


# ── Application Config (Spring Boot) ─────────────────────
# Database
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAMES_CORE_BACKEND=projekan

# host = service name (postgres), port = internal container port
DATABASE_POSTGRESQL_HOST=postgres
DATABASE_POSTGRESQL_PORT=5432
DATABASE_POSTGRESQL_SSLMODE=disable

# Comma separated
SPRING_PROFILES=postgres

JPA_DDL_AUTO=update
JPA_OSIV=false
JPA_SHOW_SQL=false

SECURITY_FILTER_LOG_LEVEL=DEBUG

# Services
SERVICES_CORE_HOST=0.0.0.0                   # Bind all interfaces
SERVICES_CORE_PORT=8081
SERVICES_FRONTEND_ORIGIN=http://localhost:5173

# App
APP_ENV=docker
APP_DEV_BASE_URL=https://dev.rascal.my.id


# ── External: ImageKit ───────────────────────────────────
IMAGEKIT_BASE_URL=https://api.imagekit.io/v1
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/rascal
IMAGEKIT_PUBLIC_KEY=public_FeLnEOhaaa1YL7pjxwIfTFu3/v0=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_WEBHOOKS_ENDPOINT=https://dev.rascal.my.id/api/v1/images/imagekit/webhooks   # not used yet :v
IMAGEKIT_WEBHOOKS_SECRET=

# ── External: Xendit ─────────────────────────────────────
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_PUBLIC_KEY=
XENDIT_PRIVATE_KEY=
XENDIT_CALLBACK_TOKEN=
