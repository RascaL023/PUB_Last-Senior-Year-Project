# ============================================================
# Native Environment — Template
# ============================================================
# Copy file ini ke native.env lalu isi sesuai kebutuhan:
#   cp config/native.env.example config/native.env
#
# File ini adalah SSOT untuk native development (tanpa Docker).
# Spring Boot akan load file ini via spring.config.import.
#
# Flow:
#   config/native.env
#     └──→ Spring Boot (via spring.config.import + APP_ENV=native)
#
# Format: UPPER_SNAKE_CASE
#
# ⚠️ JANGAN commit native.env ke version control!
# ============================================================


# ── Database ──────────────────────────────────────────────
DATABASE_PROVIDER=postgres
DATABASE_USERNAME=rascal                       # Username PostgreSQL di laptop
DATABASE_PASSWORD=                            # Kosong = no password
DATABASE_NAMES_CORE_BACKEND=projekan

# Host & port PostgreSQL di laptop
DATABASE_POSTGRESQL_HOST=localhost
DATABASE_POSTGRESQL_PORT=5555
DATABASE_POSTGRESQL_SSLMODE=disable

# MariaDB (deprecated)
DATABASE_MARIADB_HOST=localhost
DATABASE_MARIADB_PORT=3306

# SpringProfiles (comma separated)
SPRING_PROFILES=postgres,dev-seed

# JPA settings
JPA_DDL_AUTO=update
JPA_OSIV=false
JPA_SHOW_SQL=false

SECURITY_FILTER_LOG_LEVEL=DEBUG

# ── Services ──────────────────────────────────────────────
SERVICES_CORE_HOST=localhost
SERVICES_CORE_PORT=8081
SERVICES_FRONTEND_ORIGIN=http://localhost:5173


# ── App ───────────────────────────────────────────────────
APP_ENV=native
APP_DEV_BASE_URL=https://dev.rascal.my.id


# ── External: ImageKit ────────────────────────────────────
IMAGEKIT_BASE_URL=https://api.imagekit.io/v1
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/rascal
IMAGEKIT_PUBLIC_KEY=public_FeLnEOhaaa1YL7pjxwIfTFu3/v0=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_WEBHOOKS_ENDPOINT=https://dev.rascal.my.id/api/v1/images/imagekit/webhooks   # not used yet :v
IMAGEKIT_WEBHOOKS_SECRET=

# ── External: Xendit ──────────────────────────────────────
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_PUBLIC_KEY=
XENDIT_PRIVATE_KEY=
XENDIT_CALLBACK_TOKEN=
