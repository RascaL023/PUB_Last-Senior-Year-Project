<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>id.my.rascal</groupId>
        <artifactId>root-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>search-meilisearch</artifactId>
    <packaging>jar</packaging>
    <name>search-meilisearch</name>
    <description>Meilisearch implementation of the search-api contract</description>

    <dependencies>
        <!-- Search abstraction contract -->
        <dependency>
            <groupId>id.my.rascal</groupId>
            <artifactId>search-api</artifactId>
        </dependency>

        <!-- RestClient (spring-web) + Jackson untuk HTTP call langsung ke Meilisearch -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jackson databind + jsr310 (ObjectMapper dipakai langsung di adapter/bootstrap;
             jsr310 diperlukan untuk JavaTimeModule, tidak dibawa transitif oleh starter-web) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>
</project>
