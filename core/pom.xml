<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/> <!-- cari di repository eksternal, bukan file lokal -->
    </parent>

    <groupId>id.my.rascal</groupId>
    <artifactId>root-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>root-backend</name>
    <description>Modular Monolith template</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <modules>
        <module>common</module>
        <module>auth-api</module>
        <module>auth-core</module>
        <module>menu-api</module>
        <module>menu-core</module>
        <module>order-core</module>
        <module>core-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>id.my.rascal</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>id.my.rascal</groupId>
                <artifactId>auth-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>id.my.rascal</groupId>
                <artifactId>auth-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>id.my.rascal</groupId>
                <artifactId>menu-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>id.my.rascal</groupId>
                <artifactId>menu-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>id.my.rascal</groupId>
                <artifactId>order-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
