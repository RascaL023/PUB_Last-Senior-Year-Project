<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>id.my.rascal</groupId>
        <artifactId>root-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>payment-xendit</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>id.my.rascal</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- Order API (satu-satunya akses ke data order) -->
        <dependency>
            <groupId>id.my.rascal</groupId>
            <artifactId>order-api</artifactId>
        </dependency>

        <!-- Dining API (for Dine-In payment resolution) -->
        <dependency>
            <groupId>id.my.rascal</groupId>
            <artifactId>dining-api</artifactId>
        </dependency>

        <!-- Payment API  -->
        <dependency>
            <groupId>id.my.rascal</groupId>
            <artifactId>payment-api</artifactId>
        </dependency>



        <!-- Starter Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JSON (ObjectMapper for webhook payload parsing) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- Jackson databind (ObjectMapper used directly in webhook controller) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Security (provides the Xendit webhook SecurityFilterChain) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

    </dependencies>
</project>
