<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/> <!-- cari di repository eksternal, bukan file lokal -->
    </parent>

    <groupId>id.my.rascal</groupId>
    <artifactId>root-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>root-backend</name>
    <description>Modular Monolith template</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>auth-api</module>
        <module>auth-core</module>
        <module>core-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>id.my.rascal</groupId>
                <artifactId>auth-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>id.my.rascal</groupId>
                <artifactId>auth-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- <dependency> -->
        <!--     <groupId>org.springframework.boot</groupId> -->
        <!--     <artifactId>spring-boot-starter-data-jpa</artifactId> -->
        <!-- </dependency> -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- <dependency> -->
        <!--     <groupId>com.h2database</groupId> -->
        <!--     <artifactId>h2</artifactId> -->
        <!--     <scope>test</scope> -->
        <!-- </dependency> -->
    </dependencies>
</project>
